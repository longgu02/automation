# Chép file này thành `.env` rồi điền giá trị thật.
# `.env` nằm trong .gitignore -- không bao giờ commit nó.
#
# File YAML tham chiếu các biến này bằng cú pháp ${TEN_BIEN}, nên secret không
# bao giờ phải nằm trong file cấu hình.

# Chỉ cần khi dùng backend `gemini_api`.
# Lấy tại https://aistudio.google.com/apikey -- và nhớ rằng model Veo đòi dự án
# đã BẬT THANH TOÁN; gói thuê bao Google AI Pro không thay thế được điều đó.
GEMINI_API_KEY=

# Backend `flow_browser` KHÔNG cần biến nào ở đây: nó dùng phiên đăng nhập lưu
# trong .secrets/browser_profile (tạo bằng `python scripts/login_flow.py`).
